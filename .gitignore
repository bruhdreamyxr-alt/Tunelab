# ---------------------------------------------------------------
# Windows helper binaries
# ---------------------------------------------------------------
# These are 5-222 MB each and ffmpeg.exe/ffprobe.exe exceed GitHub's 100 MB
# per-file hard limit, so pushing them would be rejected. Fetch them with
# tools/fetch_win_helpers.ps1 (which build_windows.ps1 and CI both call).
ffmpeg.exe
ffprobe.exe
ffplay.exe
yt-dlp.exe
aria2c.exe
updater_cli.exe

